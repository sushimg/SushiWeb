# Veritabanı bağlantısı. Yerelde repo kökündeki .env.local'dan gelir (next.config.ts
# bunu elle yükler, çünkü Next.js yalnızca apps/accounts/.env.local'a bakar);
# Vercel'de proje ortam değişkeni olarak tanımlanır. Bu dosyaya (apps/accounts/.env.example)
# değer yazmana gerek yok — repo kökündeki .env.local'a DATABASE_URL eklemen yeterli.
DATABASE_URL=

# Uygulamanın kendi genel adresi. E-posta içindeki doğrulama ve sıfırlama
# bağlantıları bununla kurulur, istekten okunmaz — Host başlığına güvenmek,
# saldırganın kendi adresine giden bir sıfırlama linki ürettirmesine izin verir.
# Yerelde ayarlanmamışsa next.config.ts http://localhost:3001 varsayılanını
# kullanır; üretimde platform ortam değişkeni olarak tanımlanmalı.
APP_URL=http://localhost:3001
