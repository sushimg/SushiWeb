# Form delivery for the contact form and newsletter signup.
# Pick ONE approach, copy this file to `.env`, and fill in the value(s).

# Option A — Web3Forms (https://web3forms.com): paste your access key here.
VITE_WEB3FORMS_KEY=

# Option B — your own endpoint (e.g. a Formspree form URL). Anything that
# accepts a JSON POST and returns HTTP 2xx on success works.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxx
